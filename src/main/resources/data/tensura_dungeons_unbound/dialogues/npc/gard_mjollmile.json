    "d222": {
      "line": {
        "literal": "Normal has 18 slots at 1%; Special 27 at 2%, costing 20 Gold; Rare 36 at 3%, costing 80 Gold; Unique 45 at 4%, costing 250 Gold; Legend 54 at 5%, costing 750 Gold."
