    "d221": {
      "line": {
        "literal": "That's the arrangement. More storage lets serious adventurers keep larger reserves, while the higher deposit tax pays for managing that capacity. Withdrawals remain untaxed at every grade."
      },
      "actions": [],
      "type": "choice",
      "choices": [
        {
          "literal": "[Understood. Show me the grade list.]",
          "when_unavailable": "hide",
          "conditions": [],
          "actions": [],
          "goto_node": "d222"
        },
        {
          "literal": "[How are upgrades purchased?]",
          "when_unavailable": "hide",
          "conditions": [],
          "actions": [],
          "goto_node": "d230"
