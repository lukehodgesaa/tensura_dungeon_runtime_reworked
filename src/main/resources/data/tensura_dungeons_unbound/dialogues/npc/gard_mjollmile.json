          "goto_node": "d212"
        },
        {
          "literal": "[Explain the selected stack again.]",
          "when_unavailable": "hide",
          "conditions": [],
          "actions": [],
          "goto_node": "d210"
        },
        {
          "literal": "[Back to the Bank desk.]",
          "when_unavailable": "hide",
          "conditions": [],
          "actions": [],
          "goto_node": "d200"
        }
      ]
