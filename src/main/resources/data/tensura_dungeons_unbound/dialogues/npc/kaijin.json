          "goto_node": "d301"
        },
        {
          "literal": "[Back.]",
          "when_unavailable": "hide",
          "conditions": [],
          "actions": [],
          "goto_node": "d300"
        }
      ]
    },
    "d303": {
      "line": {
        "literal": "Not yet. I've got unfamiliar materials, ancient mechanisms, and a camp that was bare ground not long ago. Putting any of it into your equipment now would be guesswork. I'm a craftsman, not a gambler. Come back when I've had time to do the job properly."
      },
      "actions": [],
      "type": "choice",
      "choices": [
        {
          "literal": "[Fair enough. What are you studying?]",
          "when_unavailable": "hide",
          "conditions": [],
