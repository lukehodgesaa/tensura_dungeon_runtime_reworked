        }
      ]
    },
    "d301": {
      "line": {
        "literal": "A piece from one of the mechanisms inside. Fine work, too, though I haven't decided whether I admire the hand that made it or curse it. Until we understand what these parts were meant to do, nobody touches them without me knowing."
      },
      "actions": [],
      "type": "choice",
      "choices": [
        {
          "literal": "[Have you learned anything useful?]",
          "when_unavailable": "hide",
          "conditions": [],
          "actions": [],
          "goto_node": "d302"
        },
        {
          "literal": "[Can you use it in my equipment?]",
          "when_unavailable": "hide",
          "conditions": [],
          "actions": [],
          "goto_node": "d303"
        },
        {
          "literal": "[Back.]",
          "when_unavailable": "hide",
          "conditions": [],
          "actions": [],
          "goto_node": "d300"
        }
      ]
    },
    "d302": {
      "line": {
        "literal": "Lord Rimuru wanted someone here who could tell a tool from a trap and keep the camp standing while the others explore. That's my part in this. Once I've learned the ruins' habits, we'll know what can be repaired, what can be used, and what ought to stay buried."
      },
      "actions": [],
      "type": "choice",
      "choices": [
        {
          "literal": "[Can you make something for me yet?]",
          "when_unavailable": "hide",
          "conditions": [],
          "actions": [],
          "goto_node": "d303"
        },
        {
          "literal": "[What are you examining?]",
          "when_unavailable": "hide",
          "conditions": [],
