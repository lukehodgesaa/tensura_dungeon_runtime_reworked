    "d300": {
      "line": {
        "literal": "You need something? Lord Rimuru brought us through after Jahil opened the rift. We've made camp, but don't mistake that for having these ruins under control. Some of this workmanship is older than anything I've handled, and half of it looks ready to wake if you breathe on it wrong."
      },
      "actions": [],
      "type": "choice",
      "choices": [
        {
          "literal": "[What are you examining?]",
          "when_unavailable": "hide",
          "conditions": [],
          "actions": [],
          "goto_node": "d301"
        },
        {
          "literal": "[Why did Rimuru bring you?]",
          "when_unavailable": "hide",
          "conditions": [],
          "actions": [],
          "goto_node": "d302"
        },
        {
          "literal": "[Can you make something for me?]",
          "when_unavailable": "hide",
