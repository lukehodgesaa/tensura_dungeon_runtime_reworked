              "command": "tensuradungeon shop open {player}"
            }
          ]
        },
        {
          "literal": "Return to the briefing.",
          "when_unavailable": "hide",
          "conditions": [
            {
              "type": "player_tag",
              "id": "tensura_dungeons_unbound.dialog_read.610",
